# ==============================================================================
# DARK MOON SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment (Render sets PORT dynamically; fallback is 5000)
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas / Replica Set - REQUIRED)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.jlqdvdr.mongodb.net/darkmoon?retryWrites=true&w=majority&appName=Cluster0
REQUIRED_DATABASE_NAME=darkmoon

# Redis Connection (Pub/Sub & Socket.IO Adapter - REQUIRED on Render)
# For Render, provide internal Redis URL e.g. redis://red-xxxx:6379 or rediss://...
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=darkmoon:

# Authentication & JWT Secrets (REQUIRED in Production)
JWT_SECRET=your_super_strong_jwt_access_secret_here_min_32_chars
JWT_ACCESS_SECRET=your_super_strong_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_here_min_32_chars

# Google OAuth Authentication
GOOGLE_CLIENT_ID=your_google_web_client_id_here
GOOGLE_CLIENT_IDS=your_google_web_client_id_here

# Agora RTC Voice Party Audio Credentials (REQUIRED for voice rooms)
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
APP_CERTIFICATE=your_agora_app_certificate_here

# Google Play In-App Billing Verification (Optional/Feature-Specific)
GOOGLE_PLAY_PACKAGE_NAME=com.darkmoon.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"darkmoon-live",...}
GOOGLE_PLAY_SERVICE_ACCOUNT={"type":"service_account","project_id":"darkmoon-live",...}

# Cloudinary Media Assets (Optional/Feature-Specific)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Optional/Secondary)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Firebase Push Notifications (FCM - Optional/Feature-Specific)
FIREBASE_PROJECT_ID=darkmoon-voice-chat
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@darkmoon-voice-chat.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# KYC & Face Verification Storage & Encryption (Optional/Feature-Specific)
VERIFICATION_ENCRYPTION_KEY=your_aes_256_encryption_key_32_bytes
VERIFICATION_PRIVATE_STORAGE_PATH=./uploads/private_kyc
VERIFICATION_MAX_FILE_SIZE_MB=5

# Super Admin Bootstrap (Initial Seed)
SUPER_ADMIN_EMAIL=admin@darkmoon.app
SUPER_ADMIN_PASSWORD=change_this_strong_password_in_production
SUPER_ADMIN_PHONE=+1234567890
SUPER_ADMIN_ROLE=super_admin
