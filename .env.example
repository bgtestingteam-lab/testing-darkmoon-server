# ==============================================================================
# FAHO SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
PORT=3001
NODE_ENV=development

# Database (MongoDB Atlas / Replica Set)
MONGODB_URI=mongodb+srv://<username>:<password>@<CURRENT_ATLAS_HOST>/faho_live?retryWrites=true&w=majority&appName=Cluster0

# Redis Connection (Pub/Sub & Adapter)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=faholive:

# Authentication & JWT Secrets (REQUIRED in Production)
JWT_SECRET=your_super_strong_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_here_min_32_chars

# Google OAuth Authentication
GOOGLE_CLIENT_ID=775252509237-aeqs5cd5viou7iv4r5chq8k15ccaq7ir.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=775252509237-1us46o9umvvio0ngmbd4n1vhml8bfgdr.apps.googleusercontent.com,775252509237-aeqs5cd5viou7iv4r5chq8k15ccaq7ir.apps.googleusercontent.com

# Agora RTC Voice Party Audio Credentials (P0)
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
APP_CERTIFICATE=your_agora_app_certificate_here

# Google Play In-App Billing Verification
GOOGLE_PLAY_PACKAGE_NAME=com.darkmoon.app
GOOGLE_PLAY_SERVICE_ACCOUNT={"type":"service_account","project_id":"faho-live",...}

# Cloudinary Media Assets
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Optional/Secondary)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Firebase Push Notifications (FCM)
FIREBASE_PROJECT_ID=faho-live
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@faho-live.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# KYC & Face Verification Storage & Encryption
VERIFICATION_ENCRYPTION_KEY=your_aes_256_encryption_key_32_bytes
VERIFICATION_PRIVATE_STORAGE_PATH=./uploads/private_kyc
VERIFICATION_MAX_FILE_SIZE_MB=5

# Super Admin Bootstrap (Initial Seed)
SUPER_ADMIN_EMAIL=admin@faho.app
SUPER_ADMIN_PASSWORD=change_this_strong_password_in_production
SUPER_ADMIN_PHONE=+1234567890
SUPER_ADMIN_ROLE=super_admin
